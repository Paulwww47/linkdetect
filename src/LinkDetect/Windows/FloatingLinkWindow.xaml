<Window x:Class="LinkDetect.Windows.FloatingLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkDetect"
        Icon="/Assets/app.ico"
        Width="456"
        SizeToContent="Height"
        MaxHeight="580"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        Language="zh-CN"
        Foreground="{StaticResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed">
    <Grid Margin="20">
        <Border Padding="12,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderRow" Grid.Row="0" Margin="0,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button x:Name="TokenizeButton" Visibility="Collapsed"
                                Style="{StaticResource RingIconButtonStyle}"
                                ToolTip="按词切分这段文本" Click="TokenizeButton_OnClick"
                                AutomationProperties.Name="分词"
                                AutomationProperties.HelpText="把复制的文本按词切分，之后可点选或拖动选词。">
                            <Path Data="M1,1 H5 V5 H1 Z M7,1 H11 V5 H7 Z M1,7 H5 V11 H1 Z M7,7 H11 V11 H7 Z"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CopyTextButton" Visibility="Collapsed"
                                Style="{StaticResource RingIconButtonStyle}"
                                ToolTip="复制选中的词" Click="CopyTextButton_OnClick"
                                AutomationProperties.Name="复制所选"
                                AutomationProperties.HelpText="把选中的词按原文顺序写入剪贴板。">
                            <TextBlock x:Name="CopyCountText" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="CloseAllButton" Grid.Column="2" Style="{StaticResource CloseAllButtonStyle}"
                            ToolTip="关闭全部（Esc）；按住拖动可移动卡片" AutomationProperties.Name="关闭全部"
                            AutomationProperties.HelpText="点击关闭全部；按住并拖动可移动卡片。"
                            PreviewMouseLeftButtonDown="CloseAllButton_OnPreviewMouseLeftButtonDown"
                            PreviewMouseMove="CloseAllButton_OnPreviewMouseMove"
                            LostMouseCapture="CloseAllButton_OnLostMouseCapture"
                            Click="CloseButton_OnClick">
                        <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="360" Style="{StaticResource SlimScrollViewerStyle}"
                              Background="{StaticResource TransparentHitTargetBrush}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="2" Margin="-2,0,-2,0" Focusable="False">
                    <StackPanel>
                        <Border x:Name="ImagePreviewSection" Visibility="Collapsed"
                                Background="{StaticResource ImagePreviewBrush}"
                                BorderBrush="{StaticResource ImagePreviewBorderBrush}" BorderThickness="1"
                                CornerRadius="22" Padding="8" Margin="2,0,2,8">
                            <Image x:Name="ImagePreview" MaxHeight="210" Stretch="Uniform"
                                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="图片预览" />
                        </Border>
                        <ItemsControl x:Name="LinksList" />
                        <ItemsControl x:Name="TokensList" Visibility="Collapsed" Margin="2,8,2,0"
                                      Focusable="False"
                                      PreviewMouseDown="TokensList_OnPreviewMouseDown"
                                      PreviewMouseMove="TokensList_OnPreviewMouseMove"
                                      PreviewMouseLeftButtonUp="TokensList_OnPreviewMouseLeftButtonUp"
                                      LostMouseCapture="TokensList_OnLostMouseCapture">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TokenChipStyle}" ToolTip="{Binding Text}"
                                            AutomationProperties.Name="{Binding Text}">
                                        <TextBlock Text="{Binding Text}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="ImageButtonBar" Grid.Row="2" Visibility="Collapsed"
                        Background="{StaticResource LinkSurfaceBrush}"
                        BorderBrush="{StaticResource LinkBorderBrush}" BorderThickness="1"
                        CornerRadius="18" Padding="14,12" Margin="2,8,2,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ImageStatusIndicator" Width="6" Height="6"
                                         Margin="0,0,7,0" Fill="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="ImageStatusText" Text="正在处理图片…"
                                           FontSize="13" FontWeight="Medium"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <TextBlock x:Name="ImageDetailsText" Margin="13,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="CopyImageButton" Grid.Column="1" Content="复制图片"
                                VerticalAlignment="Center" IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CopyImageButton_OnClick" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
