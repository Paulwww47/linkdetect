<Window x:Class="LinkDetect.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LinkDetect"
        Title="LinkDetect 设置"
        Icon="/Assets/app.ico"
        Width="464"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        Language="zh-CN"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        FocusManager.FocusedElement="{Binding ElementName=ThresholdSlider}">
    <ScrollViewer Style="{StaticResource SlimScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="图片裁剪"
                           FontSize="22"
                           FontWeight="Medium" />
                <TextBlock Text="复制图片后，自动识别并去除多余背景。"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="20,16"
                    CornerRadius="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="裁剪阈值"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Padding="12,4"
                                CornerRadius="8"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock x:Name="ThresholdValueText"
                                       FontSize="24"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <Slider x:Name="ThresholdSlider"
                            Margin="0,12,0,0"
                            Minimum="{x:Static local:BackgroundThreshold.MinPercent}"
                            Maximum="{x:Static local:BackgroundThreshold.MaxPercent}"
                            TickFrequency="{x:Static local:BackgroundThreshold.StepPercent}"
                            SmallChange="{x:Static local:BackgroundThreshold.StepPercent}"
                            LargeChange="{x:Static local:BackgroundThreshold.StepPercent}"
                            IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            Style="{StaticResource ThresholdSliderStyle}"
                            AutomationProperties.Name="裁剪阈值"
                            AutomationProperties.HelpText="50% 到 90%，每次调整 5%。数值越高，裁剪越保守。"
                            ValueChanged="ThresholdSlider_OnValueChanged" />

                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="50% · 宽松"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="90% · 严格"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <TextBlock Text="数值越高，裁剪越保守，保留的背景可能更多。"
                               Margin="0,14,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DefaultThresholdText"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ResetThresholdButton"
                                Grid.Column="1"
                                Content="恢复默认"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="ResetThresholdButton_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="裁剪效果"
                               FontWeight="Medium" />
                    <TextBlock Text="示意 · 非实时预览"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Width="136"
                            CornerRadius="6"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Border Width="68"
                                    Height="40"
                                    CornerRadius="3"
                                    Background="{StaticResource AccentSoftBrush}">
                                <Canvas Width="68" Height="40">
                                    <Ellipse Canvas.Left="45" Canvas.Top="7"
                                             Width="8" Height="8"
                                             Fill="{StaticResource AccentBrush}" />
                                    <Path Data="M 4,35 L 24,13 L 36,26 L 46,19 L 64,35 Z"
                                          Fill="{StaticResource AccentBrush}"
                                          Opacity="0.7" />
                                </Canvas>
                            </Border>
                            <Rectangle Width="76"
                                       Height="48"
                                       RadiusX="4"
                                       RadiusY="4"
                                       Stroke="{StaticResource AccentBrush}"
                                       StrokeThickness="1"
                                       StrokeDashArray="3,2" />
                        </Grid>
                    </Border>

                    <Path Grid.Column="1"
                          Width="20"
                          Height="10"
                          VerticalAlignment="Center"
                          Data="M 0,5 L 19,5 M 14,0 L 19,5 L 14,10"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5" />

                    <Border Grid.Column="2"
                            Width="102"
                            Height="60"
                            CornerRadius="5"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Viewbox>
                            <Canvas Width="68" Height="40">
                                <Ellipse Canvas.Left="45" Canvas.Top="7"
                                         Width="8" Height="8"
                                         Fill="{StaticResource AccentBrush}" />
                                <Path Data="M 4,35 L 24,13 L 36,26 L 46,19 L 64,35 Z"
                                      Fill="{StaticResource AccentBrush}"
                                      Opacity="0.7" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="裁剪前"
                               Margin="0,6,0,0"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="裁剪后"
                               Margin="0,6,0,0"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <TextBlock Text="保存后，下次复制图片时生效。"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="取消"
                            MinWidth="88"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_OnClick" />
                    <Button Content="保存"
                            MinWidth="88"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OkButton_OnClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
