<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Scrollbars.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="UiFontFamily">pack://application:,,,/LinkDetect;component/Assets/Fonts/#Maple Mono NF CN</FontFamily>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F1F4F9" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E8EDF6" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E7ED" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#242936" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#626B7B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#316BDF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#265DCF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#204DB1" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDF2FD" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FFF2F0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#187044" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#5C697A" />
    <SolidColorBrush x:Key="LinkSurfaceBrush" Color="#FCFDFE" />
    <SolidColorBrush x:Key="LinkBorderBrush" Color="#DCE3EB" />
    <SolidColorBrush x:Key="ImagePreviewBrush" Color="#E6EAF0" />
    <SolidColorBrush x:Key="ImagePreviewBorderBrush" Color="#C9D2DE" />
    <SolidColorBrush x:Key="LinkHoverBrush" Color="#EEF3FD" />
    <SolidColorBrush x:Key="LinkHoverBorderBrush" Color="#D1DEF5" />
    <SolidColorBrush x:Key="CloseRingBrush" Color="#76869B" />
    <SolidColorBrush x:Key="CloseIconBrush" Color="#4F6078" />

    <Style x:Key="KeyboardFocusStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="10" RadiusY="10"
                               Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="9">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource SurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="9">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="9">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource SurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CapsuleFocusStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="24" RadiusY="24"
                               Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseAllButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10" />
        <!-- A near-transparent fill keeps the circle clickable in a layered window. -->
        <Setter Property="Background" Value="#01FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource CloseIconBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource CapsuleFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseRing" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource CloseRingBrush}" BorderThickness="1.2"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseRing" Property="Background" Value="{StaticResource LinkHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CloseRing" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Background" Value="{StaticResource LinkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LinkBorderBrush}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Margin" Value="2,0,2,8" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource CapsuleFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Render each shadow separately from its text. -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="22" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#273D55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Pill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource LinkHoverBrush}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource LinkHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MaxWidth" Value="404" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThresholdSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="32" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Margin="1,0">
                        <Border Height="4" Margin="10,0" VerticalAlignment="Center"
                                Background="{StaticResource BorderBrush}" CornerRadius="2" />
                        <Track x:Name="PART_Track" Orientation="Horizontal"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Background="{StaticResource AccentBrush}"
                                              Style="{StaticResource SliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Background="{StaticResource BorderBrush}"
                                              Style="{StaticResource SliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="11">
                                                <Ellipse x:Name="ThumbCenter" Width="10" Height="10"
                                                         Fill="{StaticResource AccentBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbCenter" Property="Width" Value="12" />
                                                    <Setter TargetName="ThumbCenter" Property="Height" Value="12" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbCenter" Property="Width" Value="8" />
                                                    <Setter TargetName="ThumbCenter" Property="Height" Value="8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
